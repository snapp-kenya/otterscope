# Build context for the image. The Dockerfile only needs the prebuilt static
# binary at the context root (the release pipeline puts it there), so keep the
# context to that instead of shipping the repo, the frontend sources, and any
# local database dumps to the daemon.
.git
.github
docs
web
**/node_modules
dist
*.db
*.db-wal
*.db-shm
.goreleaser.yaml
CLAUDE.md
README.md
docker-compose.yml
.dockerignore
